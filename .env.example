# ============================================================
# PolyRader — Environment Configuration
# Local-first CS2 simulation and review tool
# ============================================================
# In Tauri desktop mode, most settings come from config.json.
# This file is for standalone development without Tauri.
# ============================================================

# Database (SQLite file path)
DATABASE_URL=data/polyrader.db

# Polymarket (public APIs, no auth required)
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws

# Polymarket personal account (optional, read-only dashboard)
# Sync from ~/global_env:  npm run sync:env
# POLYMARKET_ADDRESS is the public profile/account address used by Data API dashboards.
# POLYMARKET_SIGNER_ADDRESS is the Polygon signer address that created the CLOB API key.
# POLYMARKET_FUNDER is the Polymarket proxy/deposit wallet, only needed for advanced live-order experiments.
POLYMARKET_ADDRESS=
POLYMARKET_SIGNER_ADDRESS=
POLYMARKET_FUNDER=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=1
# Read-only account and live orders are independent switches.
CS2_SIMBOOK_ENABLE_POLYMARKET_ACCOUNT=false
POLYMARKET_ACCOUNT_ENABLED=false
# Live trading is hidden from the main path by default per simulation-first positioning.
# Set CS2_SIMBOOK_ENABLE_MARKET_ORDERS=true to expose /api/market-orders (advanced only).
POLYMARKET_LIVE_TRADING_ENABLED=false
CS2_SIMBOOK_ENABLE_MARKET_ORDERS=false
POLYMARKET_PROBE_TOKEN_ID=

# Manifold community signals (optional)
MANIFOLD_API_URL=https://api.manifold.markets

# Polygon RPC (for whale tracking)
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# GRID Esports Data (grid.gg — official CS2/Dota2 data, auth: x-api-key header)
GRID_API_KEY=
GRID_GRAPHQL_URL=https://api-op.grid.gg/central-data/graphql
GRID_STATE_URL=https://api-op.grid.gg/live-data-feed/series-state/graphql

# Liquipedia / wiki.teamliquid.net (identity + roster facts via MediaWiki API)
# Set a real contact User-Agent before enabling scheduled sync.
LIQUIPEDIA_API_URL=https://liquipedia.net/counterstrike/api.php
LIQUIPEDIA_USER_AGENT=PolyRader/0.3 local-development (set-contact@example.com)
LIQUIPEDIA_TIMEOUT_MS=8000
LIQUIPEDIA_MIN_INTERVAL_MS=2100
POLYRADER_ENABLE_LIQUIPEDIA_SYNC=0
POLYRADER_LIQUIPEDIA_MAX_TEAMS_PER_RUN=4
POLYRADER_LIQUIPEDIA_CONFIDENCE_THRESHOLD=0.55

# HLTV lineup refresh (performance/status source)
POLYRADER_ENABLE_HLTV_LINEUP_REFRESH=1
POLYRADER_HLTV_LINEUP_MAX_MATCHES=10
POLYRADER_HLTV_DISCOVERY_ENRICH_LIMIT=3
POLYRADER_HLTV_TEAM_TTL_HOURS=6
POLYRADER_HLTV_DISCOVERY_TIMEOUT_MS=120000

# Auto-tuning (optional cron jobs — disabled by default)
POLYRADER_AUTO_TUNE_SIGNALS=0
POLYRADER_AUTO_TUNE_PROMPTS=0

# LLM API Keys (all optional — only configured providers are used)
# --- 国际模型 ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
# --- 国产模型 ---
QWEN_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
DOUBAO_API_KEY=
MINIMAX_API_KEY=
HUNYUAN_API_KEY=

# LLM Base URLs (optional — override API endpoints, e.g. for proxies)
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GOOGLE_BASE_URL=
DEEPSEEK_BASE_URL=
XAI_BASE_URL=
GROQ_BASE_URL=
QWEN_BASE_URL=
MOONSHOT_BASE_URL=
ZHIPU_BASE_URL=
DOUBAO_BASE_URL=
MINIMAX_BASE_URL=
HUNYUAN_BASE_URL=

# Encryption key for API key storage
# Tauri mode: auto-generated in config.json
# Standalone: generate with `openssl rand -base64 32`
ENCRYPTION_KEY=

# Server (standalone mode only)
NODE_ENV=development
PORT=3001
# Skip cron/stream for integration E2E (POLYRADER_SKIP_CRON=1, POLYRADER_SKIP_STREAM=1)
# WS_PORT is unused — WebSocket shares the HTTP PORT
WS_PORT=3002
CORS_ORIGIN=http://localhost:5173
