# ============================================================
# PolyRader — Environment Configuration
# Local-first CS2 simulation and review tool
# ============================================================
# In Tauri desktop mode, most settings come from config.json.
# This file is for standalone development without Tauri.
# ============================================================

# Database (SQLite file path)
DATABASE_URL=data/polyrader.db

# Polymarket (public APIs, no auth required)
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws
# Gamma browser-fetch needs a real Playwright browser cache (not the Cursor sandbox cache).
# Example: PLAYWRIGHT_BROWSERS_PATH=/Users/you/Library/Caches/ms-playwright
# PLAYWRIGHT_BROWSERS_PATH=

# Polymarket personal account (optional, read-only dashboard)
# Sync from ~/global_env:  npm run sync:env
# POLYMARKET_ADDRESS is the public profile/account address used by Data API dashboards.
# POLYMARKET_SIGNER_ADDRESS is the Polygon signer address that created the CLOB API key.
# POLYMARKET_FUNDER is the Polymarket proxy/deposit wallet, only needed for advanced live-order experiments.
POLYMARKET_ADDRESS=
POLYMARKET_SIGNER_ADDRESS=
POLYMARKET_FUNDER=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=1
# Read-only account and live orders are independent switches.
CS2_SIMBOOK_ENABLE_POLYMARKET_ACCOUNT=false
POLYMARKET_ACCOUNT_ENABLED=false
# Live trading is hidden from the main path by default per simulation-first positioning.
# Set CS2_SIMBOOK_ENABLE_MARKET_ORDERS=true to expose /api/market-orders (advanced only).
POLYMARKET_LIVE_TRADING_ENABLED=false
CS2_SIMBOOK_ENABLE_MARKET_ORDERS=false
POLYMARKET_PROBE_TOKEN_ID=

# Manifold community signals (optional)
MANIFOLD_API_URL=https://api.manifold.markets

# Polygon RPC (for whale tracking)
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# Multi-game esports sources
# GRID title IDs are contract-specific. CS2 defaults to 1; configure the others
# only when those titles are included in the GRID account/license.
GRID_API_KEY=
GRID_GRAPHQL_URL=https://api-op.grid.gg/central-data/graphql
GRID_STATE_URL=https://api-op.grid.gg/live-data-feed/series-state/graphql
GRID_TITLE_ID_CS2=1
# Optional overrides. When empty, GRID title IDs are discovered from the titles API.
GRID_TITLE_ID_LOL=
GRID_TITLE_ID_DOTA2=
GRID_TITLE_ID_VALORANT=
POLYRADER_GRID_ROSTER_TEAM_LIMIT=2

# Liquipedia identity + roster facts via each game's MediaWiki API.
# Set a real contact User-Agent before enabling scheduled sync.
LIQUIPEDIA_API_URL=
LIQUIPEDIA_API_URL_CS2=https://liquipedia.net/counterstrike/api.php
LIQUIPEDIA_API_URL_LOL=https://liquipedia.net/leagueoflegends/api.php
LIQUIPEDIA_API_URL_DOTA2=https://liquipedia.net/dota2/api.php
LIQUIPEDIA_API_URL_VALORANT=https://liquipedia.net/valorant/api.php
LIQUIPEDIA_USER_AGENT=PolyRader/0.3 local-development (set-contact@example.com)
LIQUIPEDIA_TIMEOUT_MS=8000
LIQUIPEDIA_MIN_INTERVAL_MS=2100
LIQUIPEDIA_CACHE_TTL_MS=300000
# Public MediaWiki parse API provides the rendered upcoming schedule. Licensed
# Liquipedia DB API v3 remains an optional structured-data fallback.
LIQUIPEDIA_DB_API_URL=https://api.liquipedia.net/api/v3
LIQUIPEDIA_DB_API_KEY=
POLYRADER_ENABLE_LIQUIPEDIA_SYNC=0
POLYRADER_LIQUIPEDIA_MAX_TEAMS_PER_RUN=4
POLYRADER_LIQUIPEDIA_CONFIDENCE_THRESHOLD=0.55
POLYRADER_LIQUIPEDIA_ROSTER_TEAM_LIMIT=10
POLYRADER_LIQUIPEDIA_ROSTER_ATTEMPT_LIMIT=20

# OpenDota is public; a key raises limits. Riot endpoints require a developer key,
# while LoL Data Dragon patch/static data remains public.
OPENDOTA_API_URL=https://api.opendota.com/api
OPENDOTA_API_KEY=
OPENDOTA_TIMEOUT_MS=10000
# Future-series enrichment stays bounded: at most this many details globally,
# and at most this many recent matches per resolved team.
POLYRADER_OPENDOTA_DETAIL_LIMIT=8
POLYRADER_OPENDOTA_MATCHES_PER_TEAM=3
POLYRADER_OPENDOTA_TARGET_TEAM_LIMIT=8
POLYRADER_DOTA2_STATUS_MAX_MATCHES=25
POLYRADER_GRID_STATUS_MAX_MATCHES=25
RIOT_API_KEY=
RIOT_LOL_PLATFORM_ROUTE=euw1
RIOT_VALORANT_ROUTE=eu
RIOT_API_TIMEOUT_MS=10000
RIOT_DATA_DRAGON_URL=https://ddragon.leagueoflegends.com
# Public community-maintained game-content metadata; no account key required.
VALORANT_API_URL=https://valorant-api.com
VALORANT_API_TIMEOUT_MS=10000
VALORANT_API_MIN_INTERVAL_MS=500
VALORANT_API_CACHE_TTL_MS=21600000
STEAM_WEB_API_KEY=
STRATZ_API_KEY=

# HLTV lineup refresh (performance/status source)
POLYRADER_ENABLE_HLTV_LINEUP_REFRESH=1
POLYRADER_HLTV_LINEUP_MAX_MATCHES=10
POLYRADER_HLTV_DISCOVERY_ENRICH_LIMIT=3
POLYRADER_HLTV_TEAM_TTL_HOURS=6
POLYRADER_HLTV_DISCOVERY_TIMEOUT_MS=120000
# External HTML collection is identifiable, rate-limited and cached. Use a real
# contact address in the User-Agent when running scheduled collection.
POLYRADER_CRAWLER_USER_AGENT=PolyRader/0.3 local-data-client (set-contact@example.com)
POLYRADER_CRAWLER_MIN_INTERVAL_MS=3000
POLYRADER_CRAWLER_CACHE_TTL_MS=900000
POLYRADER_CRAWLER_TIMEOUT_MS=20000
POLYRADER_CRAWLER_MAX_RETRIES=2

# Auto-tuning (optional cron jobs — disabled by default)
POLYRADER_AUTO_TUNE_SIGNALS=0
POLYRADER_AUTO_TUNE_PROMPTS=0

# LLM API Keys (all optional — only configured providers are used)
# --- 国际模型 ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
# --- 国产模型 ---
QWEN_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
DOUBAO_API_KEY=
MINIMAX_API_KEY=
HUNYUAN_API_KEY=

# LLM Base URLs (optional — override API endpoints, e.g. for proxies)
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GOOGLE_BASE_URL=
DEEPSEEK_BASE_URL=
XAI_BASE_URL=
GROQ_BASE_URL=
QWEN_BASE_URL=
MOONSHOT_BASE_URL=
ZHIPU_BASE_URL=
DOUBAO_BASE_URL=
MINIMAX_BASE_URL=
HUNYUAN_BASE_URL=

# Encryption key for API key storage
# Tauri mode: auto-generated in config.json
# Standalone: generate with `openssl rand -base64 32`
ENCRYPTION_KEY=

# Server (standalone mode only)
NODE_ENV=development
PORT=3001
# Skip cron/stream for integration E2E (POLYRADER_SKIP_CRON=1, POLYRADER_SKIP_STREAM=1)
# WS_PORT is unused — WebSocket shares the HTTP PORT
WS_PORT=3002
CORS_ORIGIN=http://localhost:5173

# Tauri updater signing (release CI only — never commit private keys)
# GitHub Actions secrets: TAURI_SIGNING_PRIVATE_KEY, TAURI_SIGNING_PRIVATE_KEY_PASSWORD
# macOS notarization (release CI only): APPLE_CERTIFICATE, APPLE_CERTIFICATE_PASSWORD,
# APPLE_SIGNING_IDENTITY, APPLE_ID, APPLE_PASSWORD, APPLE_TEAM_ID
# Local debug builds remain unsigned; tauri-smoke reports buildLabel=unsigned-local-debug
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
