{
  "name": "polyrader",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source Polymarket CS2 esports prediction analysis tool",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "turbo run dev --parallel --filter=@polyrader/server --filter=@polyrader/web",
    "dev:web": "npm run dev --workspace=packages/web",
    "build": "turbo run build",
    "build:web": "npm run build --workspace=packages/web",
    "build:server": "npm run build:bundle --workspace=packages/server",
    "tauri": "cargo tauri",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "lint": "turbo run lint",
    "knip": "knip",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "npm run test:e2e --workspace=@polyrader/web",
    "test:e2e:integration": "npm run test:e2e:integration --workspace=@polyrader/web",
    "test:e2e:account": "npm run test:e2e:account --workspace=@polyrader/web",
    "test:e2e:real-llm": "npm run test:e2e:real-llm --workspace=@polyrader/web",
    "test:e2e:live": "npm run test:e2e:live --workspace=@polyrader/web",
    "test:tauri:smoke": "node scripts/tauri-smoke.mjs",
    "ops:current-source": "node scripts/game-current-source-ops.mjs",
    "ops:current-source:all": "node scripts/current-source-smoke-all.mjs",
    "ops:cs2-sprint-i": "node scripts/game-current-source-ops.mjs cs2 --match-id 2396000",
    "ops:dota-d5": "node scripts/game-current-source-ops.mjs dota2",
    "ops:lol": "node scripts/game-current-source-ops.mjs lol",
    "ops:valorant": "node scripts/game-current-source-ops.mjs valorant",
    "ops:p5-verify": "node scripts/complete-p5-gates.mjs",
    "clean": "turbo run clean",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,css}\"",
    "sync:env": "node scripts/sync-global-env.mjs"
  },
  "devDependencies": {
    "chromium-bidi": "^0.5.8",
    "eslint": "^9.0.0",
    "knip": "^5.88.1",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.2"
}
